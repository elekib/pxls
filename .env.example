# Copy to .env and fill in. Never commit .env.

# Bluetooth MAC of your Pixoo device
PIXOO_MAC=

# Timezone, e.g. America/New_York
TZ=

# Required API token (set a long random value)
PXLS_AUTH_TOKEN=

# Comma-separated browser origins allowed to call the API
PXLS_ALLOWED_ORIGINS=

# Image tag to deploy: latest, dev, or a version like 0.1.0
PXLS_TAG=latest
