# Copy to .env and fill in. Never commit .env.

# Bluetooth MAC of your Pixoo device. Optional: the MAC saved with Connect on
# the Device page takes precedence; this is only used until one is saved.
PIXOO_MAC=

# RFCOMM channel of the display's serial port (1 on the tested Pixoo) and N in
# /dev/rfcommN. Change the device number if rfcomm0 is used by something else.
PIXOO_CHANNEL=1
PIXOO_RFCOMM_DEV=0

# Port for the web UI, API and webhook receiver (host network).
PXLS_PORT=3030

# Timezone, e.g. America/New_York
TZ=

# There is no API token. On first start pxls prints a one-time setup code to
# its log; open the UI and use it to create the admin account:
#   docker logs pxls 2>&1 | grep -i "setup code"

# Optional: session signing secret, 32+ characters (openssl rand -hex 32).
# Leave empty to generate one on first start and store it in the database.
PXLS_AUTH_SECRET=

# Public URL you reach pxls at, e.g. https://pxls.example.com (needed behind a
# reverse proxy; https marks the session cookie Secure).
PXLS_BASE_URL=

# Set to true to always mark the session cookie Secure (when PXLS_BASE_URL is not set).
PXLS_COOKIE_SECURE=

# Comma-separated extra origins trusted by the sign-in origin check, for a
# reverse proxy that rewrites Host. The API does not answer cross-origin
# (CORS) requests. Leave empty when you reach pxls directly.
PXLS_ALLOWED_ORIGINS=

# Image tag to deploy: latest, dev, or a release version
PXLS_TAG=latest

# Set to true to let webhook image URLs point at private/LAN addresses
# (for example a Jellyfin server on your network). Default: blocked.
PXLS_ALLOW_PRIVATE_URLS=false

# Set to 1 to enable the admin-only Diagnostics page and the device test
# controls (raw commands sent to the device). Leave off unless you are testing
# hardware.
PXLS_ENABLE_DEBUG=0

# Weather for the clock and weather page: a URL that returns {"temp": 21.6, "code": 3}.
# {location} and {unit} in it are replaced. Empty: no weather is drawn. See the README.
PXLS_WEATHER_URL=
