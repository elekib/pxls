# Copy to .env and fill in. Never commit .env.

# Bluetooth MAC of your Pixoo device
PIXOO_MAC=

# Timezone, e.g. America/New_York
TZ=

# There is no API token any more. On first start the backend prints a one-time
# setup code to its log; open the UI and use it to create the admin account:
#   docker logs pxls-backend 2>&1 | grep -i "setup code"
# PXLS_AUTH_TOKEN from older versions is ignored and can be removed.

# Optional: JWT signing secret, 32+ characters (openssl rand -hex 32).
# Leave empty to generate one on first start and store it in the database.
PXLS_JWT_SECRET=

# Set to true to always mark the refresh cookie Secure (use when serving over HTTPS).
PXLS_COOKIE_SECURE=

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the UI and API share an origin.
PXLS_ALLOWED_ORIGINS=

# Image tag to deploy: latest, dev, or a version like 0.1.0
PXLS_TAG=latest

# Set to true to let webhook image URLs point at private/LAN addresses
# (for example a Jellyfin server on your network). Default: blocked.
PXLS_ALLOW_PRIVATE_URLS=false

# Set to 1 to enable the admin-only Diagnostics page, which sends raw commands
# to the connected device. Leave off unless you are testing hardware.
PXLS_ENABLE_DEBUG=0
